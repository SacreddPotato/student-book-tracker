{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Student Book Tracker",
  "version": "../package.json",
  "identifier": "com.studentbooktracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Student Book Tracker",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:student-book-tracker.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQUNCQ0MyQzYwQUQ1MTcKUldRWDFRckd3cnlzYTBpdksvUmJMWFZwNzBuaG5OUkNabXR0YlNWZ0NTUW9YZ20vTjc2N1JUMSsK",
      "endpoints": [
        "https://github.com/SacreddPotato/student-book-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
