# Local development: copy this file to apps/sync-api/.env and paste the Neon testing branch URL.
# Production/CI: set the production Neon URL as a GitHub environment secret or hosting env var.
# Never commit real database URLs or sync secrets.
DATABASE_URL=
SYNC_API_SHARED_SECRET=
# Password assigned to the restricted student_book_sync_client login.
NEON_SYNC_ROLE_PASSWORD=
# Optional ignored output file for the restricted pooled URL; never commit it.
NEON_SYNC_URL_OUTPUT=
NODE_ENV=development
