{
  "name": "student-book-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev:desktop:react",
    "dev:desktop:react": "npm run tauri -w @app/desktop-react -- dev",
    "dev:desktop:legacy": "npm run tauri -w @app/desktop -- dev",
    "dev:api": "npm run dev -w @app/sync-api",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test:e2e": "npm run test:e2e -w @app/desktop-react"
  }
}
